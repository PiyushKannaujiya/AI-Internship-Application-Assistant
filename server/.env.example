# Copy this file to server/.env and replace the placeholder values.
# Never commit server/.env or real credentials.

# Server
PORT=5000
NODE_ENV=development

# Comma-separated allowed frontend origins. No trailing slash.
# Local: http://localhost:5173
# Production: https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string. Use a least-privilege database user.
# Replace USER, PASSWORD, CLUSTER, and DATABASE_NAME. URL-encode special
# characters in the password. Never put this value in the frontend.
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DATABASE_NAME?retryWrites=true&w=majority

# Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in production and must be at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Private resume uploads (bytes). Maximum accepted by the app is 10 MB.
# Files are stored in MongoDB, so keep this well below the 16 MB document limit.
UPLOAD_MAX_BYTES=5242880

# AI is optional. With AI_PROVIDER=none the API returns clearly labeled
# template output built from verified profile data.
# Set AI_PROVIDER=openai to use any OpenAI-compatible chat-completions endpoint.
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000

# Live job discovery.
# JOBS_API_URL is the Remotive endpoint kept for backwards compatibility.
JOBS_API_URL=https://remotive.com/api/remote-jobs

# Comma-separated default sources. Implemented: remotive, jobicy, arbeitnow,
# remoteok, adzuna, greenhouse, lever, ashby, workable, smartrecruiters.
# "remotive" preserves the original behavior. The India-first defaults for
# workable/smartrecruiters below come built in when these values are empty.
JOB_DISCOVERY_SOURCES=remotive
JOB_SOURCE_TIMEOUT_MS=8000

# Company boards for sources that are addressed per company. Leave empty to
# use each source's live-verified India-first default board list; clients can
# also pass boards per request.
GREENHOUSE_BOARDS=
LEVER_SITES=
ASHBY_ORGS=
WORKABLE_ACCOUNTS=
SMARTRECRUITERS_BOARDS=

# Two-letter country filter for the SmartRecruiters public posting API.
# Defaults to India ("in") so large boards surface their Indian postings.
SMARTRECRUITERS_COUNTRY=in

# Adzuna official India jobs API (https://developer.adzuna.com). Create a free
# developer account to get these values; the adzuna source stays skipped with
# a clear note until both are set. ADZUNA_COUNTRY defaults to "in" (India).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=in

# URL import reads public job pages (LinkedIn, Internshala, Wellfound, company
# career pages) as raw HTML. It is page extraction, not a platform API.
URL_IMPORT_TIMEOUT_MS=10000
URL_IMPORT_MAX_BYTES=2097152
URL_IMPORT_MAX_REDIRECTS=3

# Both options are development/test only and are rejected in production.
URL_IMPORT_ALLOW_HTTP=false
URL_IMPORT_ALLOW_PRIVATE_HOSTS=false
